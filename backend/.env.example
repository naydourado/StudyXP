# copie para .env e preencha. NUNCA versione o .env.
# gere as chaves com:  python scripts/gerar_chaves.py

# desenvolvimento | producao | teste
AMBIENTE=desenvolvimento

# mysql+pymysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=mysql+pymysql://root:SUA_SENHA@localhost:3306/studyxp

# minimo 32 caracteres aleatorios
SECRET_KEY=

# chave fernet (criptografia das observacoes do humor)
HUMOR_ENC_KEY=

ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30

# origens do front web (lista json)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# true em producao (https)
COOKIE_SECURE=false

# certificado (ca) do mysql na nuvem (aiven) para conexao tls; vazio no banco local
DATABASE_SSL_CA=

# endereco do site (links dos e-mails)
WEB_URL=http://localhost:5173

# e-mail: console (so mostra no terminal) ou resend
EMAIL_PROVEDOR=console
RESEND_API_KEY=
EMAIL_REMETENTE=StudyXP <onboarding@resend.dev>

# push: console (so mostra no terminal) ou expo
PUSH_PROVEDOR=console

# token do agendador (github actions); vazio desliga as rotas /interno/jobs
CRON_TOKEN=
